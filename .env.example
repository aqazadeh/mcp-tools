# Every setting is optional. Copy to .env or export in the environment of the server process.

# Where the database, files and keys live (created 0700).
#MCP_TOOLS_DATA_DIR=~/.mcp-tools

# Provider keys. Alternatively put the same lines in <data dir>/secrets.env (chmod 600):
# stdio clients often start the server with an empty environment.
#REPLICATE_API_TOKEN=
#OPENAI_API_KEY=
#OPENAI_ORG_ID=
#OPENAI_PROJECT_ID=

# Budget. Credits are estimates (1 credit = 0.001 USD). These are hard limits no tool can raise.
#MCP_TOOLS_INITIAL_CREDITS=10000
#MCP_TOOLS_DAILY_CAP_CREDITS=10000
#MCP_TOOLS_MAX_CREDITS_PER_CALL=5000
#MCP_TOOLS_AUTO_APPROVE_CREDITS=500

# Tool surface.
#MCP_TOOLS_FAMILIES=catalog,generate,jobs,media,billing,transforms,projects,workflows,appreg
#MCP_TOOLS_UI_ENABLED=true
#MCP_TOOLS_LOCAL_IMPORTS=true
#MCP_TOOLS_IMPORT_ROOTS=/path/one:/path/two
#MCP_TOOLS_WORKFLOW_DIRS=/path/to/my/workflows
#MCP_TOOLS_CATALOG_DIRS=/path/to/extra/catalogs

# Fetching URLs: auto | direct | proxy | off
#MCP_TOOLS_EGRESS=auto

# HTTP transport (serve --transport http).
#MCP_TOOLS_HTTP_HOST=127.0.0.1
#MCP_TOOLS_HTTP_PORT=8000
#MCP_TOOLS_PUBLIC_BASE_URL=https://media.example.com
#MCP_TOOLS_HTTP_ALLOWED_HOSTS=
#MCP_TOOLS_HTTP_ALLOWED_ORIGINS=
#MCP_TOOLS_API_KEY=

#MCP_TOOLS_LOG_LEVEL=INFO
